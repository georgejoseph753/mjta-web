# Copy to .env.local for local development, and set the same keys in
# Vercel → Project Settings → Environment Variables for the deployed site.

# --- Contact form (src/app/api/contact/route.ts) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
CONTACT_TO_EMAIL=

# --- Intern area (/intern) ---
# Shared credentials for the internal area. Without all three set, the login
# page shows a "not configured" notice and nobody can log in.
# Generate the secret with: openssl rand -base64 32
INTERN_USERNAME=
INTERN_PASSWORD=
INTERN_SESSION_SECRET=
